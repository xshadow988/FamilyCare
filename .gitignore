# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Local-only testing artifacts (never commit)
prisma/schema.local.prisma
prisma/*.db
prisma/*.db-journal
prisma/seed-local.mjs

# Database snapshots — these contain live pharmacy data (cost prices, sales,
# customer names). This repo is public, so they must stay on local disk only.
/backups/*.json
